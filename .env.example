# ============================================================
# VibePune — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Application ---
APP_NAME=VibePune
APP_VERSION=1.0.0-alpha
APP_TAGLINE=Discover places, events & experiences that match your vibe.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://vibepune_user:secret@localhost:5432/vibepune
POSTGRES_USER=vibepune_user
POSTGRES_PASSWORD=secret
POSTGRES_DB=vibepune
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# --- Places Providers ---
# Primary: OpenStreetMap (Overpass API / OSMnx) — no key required
# Enrichment: Google Places API (New) — requires key
GOOGLE_PLACES_API_KEY=

# --- Routing Provider ---
# Supported: osrm | graphhopper | openrouteservice
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=http://router.project-osrm.org
ROUTING_API_KEY=

# --- Geocoding Provider ---
# Supported: nominatim | photon | pelias
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

# --- Event Provider ---
EVENT_API_KEY=

# --- Map Tiles ---
TILE_PROVIDER=osm
TILE_URL_TEMPLATE=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Study Area Defaults (Pune, Maharashtra) ---
DEFAULT_LAT=18.5204
DEFAULT_LON=73.8567
DEFAULT_ZOOM=13

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- GeoServer & OGC Services ---
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=your_geoserver_password
GEOSERVER_PORT=8085

# --- Vector & Feature Services (PostGIS FTW) ---
PG_TILESERV_PORT=7800
PG_FEATURESERV_PORT=9000
